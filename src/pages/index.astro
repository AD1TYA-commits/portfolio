---
const github = 'https://github.com/AD1TYA-commits';
const behance = 'https://www.behance.net/adityabohra5';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content="Aditya — I like to break stuff." />
    <title>AD1TYA</title>
  </head>
  <body>
    <header class="nav" aria-label="Social links">
      <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={behance} target="_blank" rel="noopener noreferrer">Behance</a>
    </header>

    <main class="hero">
      <div class="hero-content">
        <h1>AD1TYA</h1>
        <p>I LIKE TO BREAK STUFF</p>
      </div>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background: #000;
  }

  :global(body) {
    min-height: 100vh;
    overflow: hidden;
    color: #f5f5f5;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .nav {
    position: fixed;
    z-index: 10;
    top: 22px;
    right: 40px;
    display: flex;
    align-items: center;
    gap: 25px;
  }

  .nav a {
    color: #8e8e8e;
    font-size: 14px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .nav a:hover,
  .nav a:focus-visible {
    color: #fff;
  }

  .hero {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 0 24px;
  }

  .hero-content {
    transform: translateY(-1px);
    text-align: center;
  }

  h1 {
    margin: 0;
    color: #f4f4f4;
    font-size: clamp(52px, 4.2vw, 72px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -2.2px;
  }

  p {
    margin: 25px 0 0;
    color: #858585;
    font-size: 15px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.65px;
  }

  @media (max-width: 600px) {
    .nav {
      top: 20px;
      right: 22px;
      gap: 18px;
    }

    .nav a {
      font-size: 13px;
    }

    h1 {
      font-size: 52px;
      letter-spacing: -1.7px;
    }

    p {
      margin-top: 19px;
      font-size: 12px;
      letter-spacing: 0.55px;
    }
  }
</style>
